# VeriFact Multi-Agent Configuration
# Copy this file to .env and configure your environment

APP_NAME=VeriFact-MultiAgent
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Rate Limiting & Security
RATE_LIMIT_PER_MINUTE=60
MAX_CLAIM_LENGTH=1000
MAX_CLAIMS_PER_ANALYSIS=10
CORS_ORIGINS=["*"]

# Agent Execution Settings
MAX_PARALLEL_RESEARCH_TASKS=4
AGENT_TIMEOUT_SECONDS=15
MIN_CONFIDENCE_THRESHOLD=0.60
STRICT_CITATION_VERIFICATION=true

# Optional External API Keys (Fallback mock search provider works offline)
SEARCH_API_KEY=
LLM_API_KEY=
